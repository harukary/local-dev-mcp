{
  "name": "local-dev-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http 3456",
    "serve": "tsx src/index.ts serve",
    "doctor": "tsx src/index.ts doctor",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "server:http": "bash scripts/server.sh",
    "tunnel": "bash scripts/tunnel.sh",
    "tunnel:only": "bash scripts/tunnel.sh --tunnel-only",
    "launchd:install": "bash scripts/install-launchd.sh --install-only"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "agent-device": "0.20.10",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
